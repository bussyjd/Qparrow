<?xml version="1.0" encoding="UTF-8"?>
<!-- Modified for Qparrow: independent fork attribution and naming. -->

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.sparrowwallet.sparrow.control.DialogImage?>

<StackPane prefHeight="460.0" prefWidth="600.0" stylesheets="@about.css, @general.css" fx:controller="com.sparrowwallet.sparrow.AboutController" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <VBox spacing="20">
        <HBox styleClass="title-area">
            <HBox alignment="CENTER_LEFT">
                <Label fx:id="title" text="Qparrow" styleClass="title-label" />
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <DialogImage type="SPARROW" AnchorPane.rightAnchor="0"/>
        </HBox>
        <VBox spacing="10" styleClass="content-area">
            <Label text="Qparrow is a node-backed Bitcoin Quantum wallet. BTQ Core owns the ML-DSA keys and performs P2MR signing while the protocol integration is proven." wrapText="true" />
            <Label text="Qparrow is derived from Sparrow Wallet under the Apache License 2.0. Bitcoin-only signing and hardware-wallet paths remain disabled for BTQ wallets until they are independently proven quantum-safe." wrapText="true" />
            <Label text="Project source and development status are available at https://github.com/bussyjd/Qparrow." wrapText="true" />
        </VBox>
        <HBox styleClass="button-area" alignment="BOTTOM_RIGHT" VBox.vgrow="SOMETIMES">
            <Button text="Close" onAction="#close" />
        </HBox>
    </VBox>
</StackPane>
